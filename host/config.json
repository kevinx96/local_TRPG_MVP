{
  "active_backend": "ollama",
  "backends": {
    "ollama": {
      "base_url": "http://localhost:11434/v1",
      "model": "qwen3-swallow-8b-rl-local",
      "fallback_models": [
        "qwen2.5-7b-instruct-local",
        "qwen2.5-3b-instruct-q8-0-local",
        "qwen2.5-3b-instruct-q5-k-m-local",
        "elyza-jp-8b-local"
      ],
      "api_key": "ollama"
    },
    "koboldcpp": {
      "base_url": "http://localhost:5001/v1",
      "model": "elyza-jp-8b-local",
      "fallback_models": [
        "qwen3-swallow-8b-rl-local",
        "qwen2.5-7b-instruct-local",
        "qwen2.5-3b-instruct-q8-0-local",
        "qwen2.5-3b-instruct-q5-k-m-local",
        "qwen2.5:7b-instruct"
      ],
      "api_key": "koboldcpp"
    }
  },
  "request_timeout_seconds": 1800,
  "temperature": 0.8,
  "max_tokens": 2048,
  "response_format": "json_object",
  "prompting": {
    "history_messages": 4,
    "memory_max_chars": 1200,
    "action_history_max": 40,
    "action_history_item_chars": 80
  },
  "debug_llm": true,
  "demo_fallback_on_error": true
}
