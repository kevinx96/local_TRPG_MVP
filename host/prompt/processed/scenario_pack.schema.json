{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.trpg/scenario_pack.schema.json",
  "title": "TRPG Scenario Pack",
  "type": "object",
  "required": ["meta", "scenes"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "initial_scene"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "language": { "type": "string" },
        "initial_scene": { "type": "string" }
      }
    },
    "rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/record" },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "goals": {
                "type": "array",
                "items": { "type": "string" }
              },
              "location_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "npc_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "item_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "clue_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "fallback_choices": {
                "type": "array",
                "items": { "$ref": "#/$defs/choice" }
              },
              "hybrid": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "mode": { "type": "string" },
                  "summary": { "type": "string" },
                  "opening": { "type": "string" },
                  "dialogue_turns": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dialogue_turn" }
                  },
                  "beats": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/record" }
                  },
                  "branches": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/record" }
                  },
                  "gm_notes": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "locations": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    },
    "npcs": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    },
    "clues": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    },
    "fallback_choices": {
      "type": "array",
      "items": { "$ref": "#/$defs/choice" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "name": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "choice": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": true,
          "properties": {
            "text": { "type": "string" },
            "preview": { "type": "string" },
            "risk": { "type": "string" }
          }
        }
      ]
    },
    "dialogue_turn": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "trigger_keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gm_text": { "type": "string" },
        "state_delta": { "type": "object" },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/choice" }
        },
        "followups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "choice_text": { "type": "string" },
              "gm_text": { "type": "string" },
              "state_delta": { "type": "object" },
              "next_scene": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
