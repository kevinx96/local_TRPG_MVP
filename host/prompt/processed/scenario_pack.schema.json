{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.trpg/scenario_pack.schema.json",
  "title": "TRPG Scenario Pack",
  "type": "object",
  "required": ["meta", "scenes"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "initial_scene"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "language": { "type": "string" },
        "initial_scene": { "type": "string" }
      }
    },
    "rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "combat_rules": { "$ref": "#/$defs/combat_rules" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/record" },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "goals": {
                "type": "array",
                "items": { "type": "string" }
              },
              "location_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "next_scene_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "fallback_choices": {
                "type": "array",
                "items": { "$ref": "#/$defs/choice" }
              },
              "actions": {
                "type": "array",
                "items": { "$ref": "#/$defs/action" }
              },
              "hybrid": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "mode": { "type": "string" },
                  "summary": { "type": "string" },
                  "opening": { "type": "string" },
                  "prepared_turns": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/prepared_turn" }
                  },
                  "dialogue_turns": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dialogue_turn" }
                  },
                  "beats": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/record" }
                  },
                  "branches": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/record" }
                  },
                  "gm_notes": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/record" },
          {
            "type": "object",
            "properties": {
              "scene_id": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "npcs": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    },
    "clues": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    },
    "enemies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "image": { "type": "string" },
          "hp": { "type": "integer" },
          "max_hp": { "type": "integer" },
          "mp": { "type": "integer" },
          "max_mp": { "type": "integer" },
          "sp": { "type": "integer" },
          "max_sp": { "type": "integer" },
          "attributes": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "combat": { "$ref": "#/$defs/combat_actor" },
          "resistances": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 0 }
          },
          "rewards": { "$ref": "#/$defs/combat_rewards" },
          "skills": {
            "type": "array",
            "items": { "$ref": "#/$defs/combat_skill" }
          }
        }
      }
    },
    "combat_choices": {
      "type": "array",
      "items": { "$ref": "#/$defs/choice" }
    },
    "attribute_defs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "initial_value": { "type": "number", "default": 8 }
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "default_name": { "type": "string" },
          "description": { "type": "string" },
          "image": { "type": "string" },
          "image_female": { "type": "string" },
          "hp": { "type": "integer" },
          "max_hp": { "type": "integer" },
          "mp": { "type": "integer" },
          "max_mp": { "type": "integer" },
          "sp": { "type": "integer" },
          "max_sp": { "type": "integer" },
          "gold": { "type": "integer" },
          "attributes": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "inventory": { "type": "array" },
          "equipment": { "type": "array" },
          "combat": { "$ref": "#/$defs/combat_actor" },
          "skills": {
            "type": "array",
            "items": { "$ref": "#/$defs/combat_skill" }
          }
        }
      }
    },
    "fallback_choices": {
      "type": "array",
      "items": { "$ref": "#/$defs/choice" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "name": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "combat": { "type": "object", "additionalProperties": true }
      }
    },
    "combat_rules": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "basic_attack": { "$ref": "#/$defs/combat_attack" },
        "enemy_basic_attack": { "$ref": "#/$defs/combat_attack" },
        "defend_multiplier": { "type": "number", "minimum": 0, "maximum": 1 },
        "flee_formula": { "type": "string" },
        "flee_dc": { "type": "integer", "minimum": 0 },
        "sp_regen_per_round": { "type": "integer", "minimum": 0 },
        "max_rounds": { "type": "integer", "minimum": 1 }
      }
    },
    "combat_actor": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "basic_attack": { "$ref": "#/$defs/combat_attack" },
        "defense": { "type": "integer", "minimum": 0 },
        "evade": { "type": "integer" }
      }
    },
    "combat_attack": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "damage": { "type": "string" },
        "accuracy": { "type": "integer", "minimum": 0, "maximum": 100 },
        "element": { "type": "string" }
      }
    },
    "combat_skill": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["attack", "heal", "defend", "status"] },
        "description": { "type": "string" },
        "damage": { "type": "string" },
        "healing": { "type": "string" },
        "accuracy": { "type": "integer", "minimum": 0, "maximum": 100 },
        "element": { "type": "string" },
        "cost": { "type": "integer", "minimum": 0 },
        "cost_type": { "enum": ["", "hp", "mp", "sp"] },
        "ai_weight": { "type": "integer", "minimum": 1 },
        "guard_multiplier": { "type": "number", "minimum": 0, "maximum": 1 },
        "survive_at_one": { "type": "boolean" }
      }
    },
    "combat_rewards": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "gold": { "type": "integer", "minimum": 0 },
        "items": { "type": "array" },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "choice": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": true,
          "properties": {
            "text": { "type": "string" },
            "id": { "type": "string" },
            "action_id": { "type": "string" },
            "preview": { "type": "string" },
            "risk": { "type": "string" },
            "intent_keywords": {
              "type": "array",
              "items": { "type": "string" }
            },
            "roll": { "$ref": "#/$defs/action_roll" },
            "effects": {
              "type": "array",
              "items": { "$ref": "#/$defs/action_effect" }
            },
            "success_effects": {
              "type": "array",
              "items": { "$ref": "#/$defs/action_effect" }
            },
            "failure_effects": {
              "type": "array",
              "items": { "$ref": "#/$defs/action_effect" }
            },
            "once": { "type": "string" },
            "disabled_after": { "type": "string" },
            "visible_after": { "type": "string" },
            "prepared_turn_id": { "type": "string" },
            "requirements": { "$ref": "#/$defs/choice_requirements" },
            "enabled": { "type": "boolean" },
            "disabled_reason": { "type": "string" },
            "children": {
              "type": "array",
              "items": { "$ref": "#/$defs/choice" }
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "preview": { "type": "string" },
        "risk": { "type": "string" },
        "intent_keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requirements": { "$ref": "#/$defs/choice_requirements" },
        "roll": { "$ref": "#/$defs/action_roll" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/action_effect" }
        },
        "success_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/action_effect" }
        },
        "failure_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/action_effect" }
        },
        "once": { "type": "string" },
        "disabled_after": { "type": "string" },
        "visible_after": { "type": "string" },
        "prepared_turn_id": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "action_roll": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dice_type": { "type": "string" },
        "dc": { "type": "integer" }
      }
    },
    "action_effect": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "gold_change": { "type": "integer" },
        "add_item": {},
        "remove_item": {},
        "inventory_add": { "type": "array" },
        "inventory_remove": { "type": "array" },
        "set_flag": { "type": "string" },
        "unset_flag": { "type": "string" },
        "current_scene": { "type": "string" },
        "current_location": { "type": "string" },
        "next_scene": { "type": "string" },
        "next_location": { "type": "string" }
      }
    },
    "choice_requirements": {
      "oneOf": [
        { "$ref": "#/$defs/attribute_requirement" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/choice_requirements" }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "any": {
              "type": "array",
              "items": { "$ref": "#/$defs/choice_requirements" }
            },
            "all": {
              "type": "array",
              "items": { "$ref": "#/$defs/choice_requirements" }
            }
          }
        }
      ]
    },
    "attribute_requirement": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "attribute": { "type": "string" },
        "gte": { "type": "number" },
        "min": { "type": "number" },
        "gt": { "type": "number" }
      }
    },
    "dialogue_turn": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "trigger_keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gm_text": { "type": "string" },
        "state_delta": { "type": "object" },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/choice" }
        },
        "followups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "choice_text": { "type": "string" },
              "gm_text": { "type": "string" },
              "state_delta": { "type": "object" },
              "next_scene": { "type": "string" }
            }
          }
        }
      }
    },
    "prepared_turn": {
      "type": "object",
      "required": ["id", "draft"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "action_id": { "type": "string" },
        "outcome": { "type": "string" },
        "purpose": { "type": "string" },
        "source_choice": { "type": "string" },
        "player_intent": { "type": "string" },
        "trigger_keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "draft": {
          "type": "object",
          "required": ["gm_text"],
          "additionalProperties": true,
          "properties": {
            "gm_text": { "type": "string" },
            "system_log": { "type": "string" },
            "dice_type": { "type": "string" },
            "dice_dc": { "type": "integer" },
            "state_delta": { "type": "object" },
            "choices": {
              "type": "array",
              "items": { "$ref": "#/$defs/choice" }
            }
          }
        },
        "rewrite_notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
